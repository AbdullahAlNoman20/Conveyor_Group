# ---------------------------- Before --------------------------

# NODE_ENV=development
# PORT=4000
# HOST=0.0.0.0
# LOG_LEVEL=info
# # Comma-separated allow-list. Multiple entries let localhost and a deployed
# # frontend both be permitted during a rollout.
# APP_PUBLIC_URL=http://localhost:5173

# # Local dev talks straight to Postgres. PgBouncer only matters under real
# # load and is used by the containerised API in the prod profile.
# DATABASE_URL=postgres://cccms:cccms@localhost:5432/cccms
# DATABASE_POOL_MAX=20
# DATABASE_SSL=false

# REDIS_URL=redis://localhost:6379

# # Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_ACCESS_SECRET=bcb7ea8f164c5458222e48c2402e6f247ca619dde1b99246953a6023c6aa0116
# JWT_REFRESH_SECRET=f5cf6b94a35460f5889d42cc63975988bbc8e9f22b68685d9b6a34a79d245a02
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# # Leave COOKIE_DOMAIN blank when the frontend and API sit on different hosts
# # (e.g. two Render subdomains) — a Domain attribute would make the cookie
# # unusable there. Set it only when both share one parent domain.
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false

# # strict : frontend and API on the SAME origin (VPS behind one nginx) — safest
# # none   : different origins (Render demo). Requires COOKIE_SECURE=true.
# COOKIE_SAMESITE=strict

# SUPABASE_URL=https://ufyibyfjqnycbffxrytb.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_IMvjvouWIWCuNM6iTFn_ow_cfOmZSSK
# SUPABASE_BUCKET=cccms
# SIGNED_URL_TTL_SECONDS=300
# MAX_UPLOAD_BYTES=2097152

# # All business-day boundaries are evaluated in this zone, never UTC.
# APP_TIMEZONE=Asia/Dhaka
# # Cancel today's meal before this local hour; after it, the meal is committed.
# MEAL_CANCEL_CUTOFF_HOUR=6
# # The counter is open between these local hours (11:00 - 18:00). Outside the
# # window nobody can place an order. The no-show sweep runs one minute after
# # MEAL_ORDER_END_HOUR, so it is derived rather than configured separately.
# MEAL_ORDER_START_HOUR=11
# MEAL_ORDER_END_HOUR=18

# DEFAULT_DAILY_MEAL_LIMIT=300
# SELF_ORDER_STATION_CODE=CONVEYOR-SELF-ORDER-STATION-01
# SEED_ADMIN_EMAIL=superadmin@conveyorgroup.com
# SEED_DEFAULT_PASSWORD=Demo@123

# ENABLE_SWAGGER=true

# # LOCAL DEVELOPMENT ONLY. Unlocks the time-travel clock and sample-data
# # generation so the daily limits and monthly reports can be tested in minutes
# # instead of weeks. The server refuses to boot with this on in production.
# DEV_TOOLS=true




