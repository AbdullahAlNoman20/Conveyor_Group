NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
APP_PUBLIC_URL=http://localhost:5173

DATABASE_URL=postgres://cccms:cccms@localhost:5432/cccms
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379

# openssl rand -hex 64
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

STORAGE_DIR=./uploads
FILES_BASE_URL=http://localhost:4000/api/v1/files
FILE_URL_SECRET=change-me
MAX_UPLOAD_BYTES=10485760

APP_TIMEZONE=Asia/Dhaka
MEAL_CANCEL_CUTOFF_HOUR=6
MEAL_ORDER_START_HOUR=11
MEAL_ORDER_END_HOUR=18

DEFAULT_DAILY_MEAL_LIMIT=300
SELF_ORDER_STATION_CODE=CONVEYOR-SELF-ORDER-STATION-01
SEED_ADMIN_EMAIL=superadmin@conveyorgroup.com
SEED_DEFAULT_PASSWORD=Demo@123

ENABLE_SWAGGER=true
# Local only. Server refuses to start with this in production.
DEV_TOOLS=true